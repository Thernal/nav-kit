<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application
        android:name="io.thernal.navkit.sample.android.SampleApplication"
        android:allowBackup="false"
        android:label="nav-kit sample"
        android:supportsRtl="true"
        android:theme="@style/Theme.NavKitSample">

        <activity
            android:name="io.thernal.navkit.sample.android.MainActivity"
            android:exported="true"
            android:label="nav-kit sample"
            android:launchMode="singleTop">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- `adb shell am start -d navkit://orders/77` reaches the same handlers the in-app
                 playground does. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="navkit" />
            </intent-filter>
        </activity>
    </application>

</manifest>
